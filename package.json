{
  "name": "khodkar",
  "version": "0.1.0",
  "private": true,
  "description": "Self-serve automation platform for Iranian small businesses",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @khodkar/db generate",
    "db:migrate": "pnpm --filter @khodkar/db migrate",
    "db:seed": "pnpm --filter @khodkar/db seed",
    "db:seed:pilot": "pnpm --filter @khodkar/worker seed:pilot"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    }
  }
}
